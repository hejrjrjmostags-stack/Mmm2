-- ═══════════════════════════════════════════════════════════════════
--  HOME DASHBOARD + SYSTEM CONFIG  (wrapped: adds no top-level locals)
-- ═══════════════════════════════════════════════════════════════════
xpcall(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Stats = game:GetService("Stats")
    local HttpService = game:GetService("HttpService")
    local MarketplaceService = game:GetService("MarketplaceService")
    local TeleportService = game:GetService("TeleportService")
    local LP = Players.LocalPlayer
    local alive = true

    pcall(function() Window:OnDestroy(function() alive = false end) end)
    if STATE and STATE.onCleanup then pcall(function() STATE.onCleanup(function() alive = false end) end) end

    -- generic safe element creator: parent:Method(cfg)
    local function mk(parent, method, cfg)
        local ok, res = pcall(function() return parent[method](parent, cfg) end)
        if not ok then warn("[Spectre UI] " .. tostring(method) .. " failed: " .. tostring(res)) end
        return ok and res or nil
    end
    local function setP(el, title, desc)
        if not el then return end
        pcall(function() if title then el:SetTitle(title) end end)
        pcall(function() if desc then el:SetDesc(desc) end end)
    end
    local function notify(title, content, icon, dur)
        pcall(function() WindUI:Notify({Title = title, Content = content or "", Icon = icon or "bell", Duration = dur or 3}) end)
    end
    local function copy(text)
        if setclipboard then
            pcall(setclipboard, tostring(text))
            notify("Copied", tostring(text), "clipboard", 2)
        else
            notify("Clipboard not supported", "Your executor has no setclipboard", "x", 3)
        end
    end

    -- ───────────────────────── HOME ─────────────────────────
    local home = prebuiltTabs["Home"]
    local dash = mk(home, "Section", {Title = "Dashboard", Opened = true}) or home

    local execName, execVer = "Unknown", ""
    pcall(function()
        local n, v = identifyexecutor()
        execName = tostring(n or "Unknown")
        execVer = v and tostring(v) or ""
    end)
    local lowerExec = string.lower(execName)
    local execHint = ""
    if lowerExec:find("xeno") or lowerExec:find("solara") then
        execHint = "\nTip: use the \"Xeno & Solara Reach\" tab (Reach Method 1 is not supported)."
    end

    local welcome = mk(dash, "Paragraph", {
        Title = "Hi, " .. LP.DisplayName,
        Desc = "@" .. LP.Name .. "  •  ID " .. tostring(LP.UserId) .. "  •  Account age " .. tostring(LP.AccountAge) .. " days",
        Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(LP.UserId) .. "&w=150&h=150",
        ImageSize = 48,
    })
    local perf = mk(dash, "Paragraph", {Title = "Performance", Desc = "FPS: --   |   Ping: -- ms"})
    local execCard = mk(dash, "Paragraph", {
        Title = "Executor",
        Desc = execName .. (execVer ~= "" and (" " .. execVer) or "") .. execHint,
    })
    local mapCard = mk(dash, "Paragraph", {Title = "Current map", Desc = "Loading..."})
    local featCard = mk(dash, "Paragraph", {Title = "Active features", Desc = "None"})

    local mapName = game.Name
    task.spawn(function()
        local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
        if ok and info and info.Name then mapName = info.Name end
    end)

    local frames, last = 0, os.clock()
    local fpsConn = RunService.RenderStepped:Connect(function() frames = frames + 1 end)

    local function activeFeatures()
        local list = {}
        pcall(function() if tbl1.m1_on then table.insert(list, "Reach M1") end end)
        pcall(function() if tbl2.on then table.insert(list, "Reach M2") end end)
        pcall(function() if tbl4.on then table.insert(list, "Xeno/Solara Reach") end end)
        pcall(function() if tbl7.on then table.insert(list, "GK Auto") end end)
        if #list == 0 then return "None" end
        return table.concat(list, "  •  ")
    end

    task.spawn(function()
        while alive do
            task.wait(1)
            if not alive then break end
            local now = os.clock()
            local fps = math.floor(frames / math.max(now - last, 0.001) + 0.5)
            frames, last = 0, now

            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
            local quality = ping < 80 and "Good" or (ping < 150 and "OK" or "Bad")
            local fpsQ = fps >= 50 and "Smooth" or (fps >= 30 and "Playable" or "Low")

            setP(perf, nil, "FPS: " .. fps .. " (" .. fpsQ .. ")   |   Ping: " .. ping .. " ms (" .. quality .. ")")
            setP(mapCard, nil, mapName ..
                "\nPlace ID: " .. tostring(game.PlaceId) ..
                "   |   Players: " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers)
            setP(featCard, nil, activeFeatures())
        end
        pcall(function() fpsConn:Disconnect() end)
    end)

    notify("Hi, " .. LP.DisplayName, "Spectre loaded successfully", "hand", 4)

    -- ──────────────────── SYSTEM CONFIG (Settings tab) ────────────────────
    local st = prebuiltTabs["Settings"]
    local FILE, FOLDER = "SpectreccHub/UI.json", "SpectreccHub"

    local defaults = {
        scale = 1, width = 650, height = 520,
        transparent = false, transparency = 0.2,
        theme = "Dark", toggleKey = "RightControl",
        openButton = true, openDraggable = true, notifLower = false,
        autosave = false, autosaveEvery = 30,
        fpscap = -1, antiafk = false,
    }
    local cfg = {}
    for k, v in pairs(defaults) do cfg[k] = v end

    pcall(function()
        if isfile and isfile(FILE) then
            local data = HttpService:JSONDecode(readfile(FILE))
            for k, v in pairs(data) do
                if defaults[k] ~= nil and type(v) == type(defaults[k]) then cfg[k] = v end
            end
        end
    end)

    local saveToken = 0
    local function saveUI()
        pcall(function()
            if not writefile then return end
            if makefolder and isfolder and not isfolder(FOLDER) then makefolder(FOLDER) end
            writefile(FILE, HttpService:JSONEncode(cfg))
        end)
    end
    local function touch()
        saveToken = saveToken + 1
        local mine = saveToken
        task.delay(1, function() if mine == saveToken then saveUI() end end)
    end

    -- appliers
    local function applyScale() pcall(function() Window:SetUIScale(cfg.scale) end) end
    local function applySize()
        local w, h = cfg.width, cfg.height
        local ok = pcall(function() Window:SetSize(UDim2.fromOffset(w, h)) end)
        if not ok then
            ok = pcall(function() Window:SetSize(Vector2.new(w, h)) end)
        end
        if not ok then
            pcall(function() Window.UIElements.Main.Size = UDim2.fromOffset(w, h) end)
        end
    end
    local function applyTransparency()
        pcall(function() WindUI.TransparencyValue = cfg.transparency end)
        pcall(function() Window:ToggleTransparency(cfg.transparent) end)
    end
    local function applyTheme() pcall(function() WindUI:SetTheme(cfg.theme) end) end
    local function applyKey()
        pcall(function()
            local key = Enum.KeyCode[cfg.toggleKey]
            if key then Window:SetToggleKey(key) end
        end)
    end
    local function applyOpenButton()
        pcall(function()
            Window:EditOpenButton({Enabled = cfg.openButton, Draggable = cfg.openDraggable, OnlyMobile = false})
        end)
    end
    local function applyNotif() pcall(function() WindUI:SetNotificationLower(cfg.notifLower) end) end
    local function applyFps()
        if cfg.fpscap >= 0 and setfpscap then pcall(setfpscap, cfg.fpscap) end
    end
    local afkConn
    local function applyAFK()
        if afkConn then pcall(function() afkConn:Disconnect() end) afkConn = nil end
        if cfg.antiafk then
            afkConn = LP.Idled:Connect(function()
                pcall(function()
                    local vu = game:GetService("VirtualUser")
                    vu:CaptureController()
                    vu:ClickButton2(Vector2.new())
                end)
            end)
        end
    end
    local function applyAll()
        applyScale(); applySize(); applyTransparency(); applyTheme()
        applyKey(); applyOpenButton(); applyNotif(); applyFps(); applyAFK()
    end

    -- extend the existing "Config Save / Load" section (v32) with more tools
    v32:CreateToggle({
        Name = "Auto-save config",
        Description = "Saves all feature settings every N seconds",
        CurrentValue = cfg.autosave,
        Callback = function(v) cfg.autosave = v; touch() end,
    })
    v32:CreateSlider({
        Name = "Auto-save interval (sec)",
        Range = {10, 300}, Increment = 5, CurrentValue = cfg.autosaveEvery,
        Callback = function(v) cfg.autosaveEvery = math.floor(v); touch() end,
    })
    v32:CreateButton({
        Name = "Export config to clipboard",
        Description = "Copies your current config as JSON",
        Callback = function()
            pcall(func22, false)
            local ok, data = pcall(function() return readfile("SpectreccHub/Config.json") end)
            if ok and data then copy(data) else notify("Export failed", "Config file not found", "x", 3) end
        end,
    })
    v32:CreateInput({
        Name = "Import config (paste JSON, press Enter)",
        PlaceholderText = "{ ... }",
        CurrentValue = "",
        Callback = function(text)
            if not text or text == "" then return end
            local ok = pcall(function() HttpService:JSONDecode(text) end)
            if not ok then notify("Import failed", "That is not valid JSON", "x", 3) return end
            pcall(function()
                if makefolder and isfolder and not isfolder(FOLDER) then makefolder(FOLDER) end
                writefile("SpectreccHub/Config.json", text)
            end)
            pcall(func24, true)
        end,
    })

    task.spawn(function()
        while alive do
            task.wait(math.max(cfg.autosaveEvery, 10))
            if alive and cfg.autosave then
                pcall(func22, false)
                saveUI()
            end
        end
    end)

    -- element handles for reset
    local ui = {}

    ---------------- Interface ----------------
    local sI = mk(st, "Section", {Title = "Interface", Opened = true}) or st
    mk(sI, "Paragraph", {
        Title = "UI Settings",
        Desc = "Scale, size, theme and open key. Everything here is saved automatically.",
    })
    ui.scale = mk(sI, "Slider", {
        Title = "UI scale (%)", Desc = "Make the whole window bigger or smaller",
        Value = {Min = 50, Max = 150, Default = math.floor(cfg.scale * 100 + 0.5)}, Step = 5,
        IsTooltip = true, IsTextbox = true,
        Callback = function(v) cfg.scale = v / 100; applyScale(); touch() end,
    })
    mk(sI, "Button", {
        Title = "Bigger UI (+10%)",
        Callback = function()
            cfg.scale = math.clamp(cfg.scale + 0.1, 0.5, 1.5); applyScale(); touch()
            if ui.scale then pcall(function() ui.scale:Set(math.floor(cfg.scale * 100 + 0.5)) end) end
        end,
    })
    mk(sI, "Button", {
        Title = "Smaller UI (-10%)",
        Callback = function()
            cfg.scale = math.clamp(cfg.scale - 0.1, 0.5, 1.5); applyScale(); touch()
            if ui.scale then pcall(function() ui.scale:Set(math.floor(cfg.scale * 100 + 0.5)) end) end
        end,
    })
    ui.width = mk(sI, "Slider", {
        Title = "Window width", Value = {Min = 420, Max = 1000, Default = cfg.width}, Step = 10,
        IsTooltip = true, IsTextbox = true,
        Callback = function(v) cfg.width = math.floor(v); applySize(); touch() end,
    })
    ui.height = mk(sI, "Slider", {
        Title = "Window height", Value = {Min = 360, Max = 800, Default = cfg.height}, Step = 10,
        IsTooltip = true, IsTextbox = true,
        Callback = function(v) cfg.height = math.floor(v); applySize(); touch() end,
    })

    local themeNames = {}
    pcall(function() for n in pairs(WindUI:GetThemes()) do table.insert(themeNames, tostring(n)) end end)
    table.sort(themeNames)
    if #themeNames == 0 then themeNames = {"Dark", "Light"} end
    ui.theme = mk(sI, "Dropdown", {
        Title = "Theme", Values = themeNames, Value = cfg.theme,
        Multi = false, AllowNone = false, SearchBarEnabled = true,
        Callback = function(v)
            if type(v) == "table" then v = v[1] end
            if v then cfg.theme = tostring(v); applyTheme(); touch() end
        end,
    })
    ui.transparent = mk(sI, "Toggle", {
        Title = "Transparent window", Value = cfg.transparent,
        Callback = function(v) cfg.transparent = v; applyTransparency(); touch() end,
    })
    ui.transparency = mk(sI, "Slider", {
        Title = "Transparency (%)", Value = {Min = 0, Max = 90, Default = math.floor(cfg.transparency * 100 + 0.5)}, Step = 5,
        IsTooltip = true, IsTextbox = true,
        Callback = function(v) cfg.transparency = v / 100; applyTransparency(); touch() end,
    })
    ui.key = mk(sI, "Keybind", {
        Title = "Show / hide key", Desc = "Key that opens and closes the window",
        Value = cfg.toggleKey,
        Callback = function(v)
            local name = (typeof(v) == "EnumItem") and v.Name or tostring(v)
            if Enum.KeyCode[name] then cfg.toggleKey = name; applyKey(); touch() end
        end,
    })
    ui.openBtn = mk(sI, "Toggle", {
        Title = "Show open button", Value = cfg.openButton,
        Callback = function(v) cfg.openButton = v; applyOpenButton(); touch() end,
    })
    ui.openDrag = mk(sI, "Toggle", {
        Title = "Open button draggable", Value = cfg.openDraggable,
        Callback = function(v) cfg.openDraggable = v; applyOpenButton(); touch() end,
    })
    ui.notif = mk(sI, "Toggle", {
        Title = "Notifications at the bottom", Value = cfg.notifLower,
        Callback = function(v) cfg.notifLower = v; applyNotif(); touch() end,
    })
    mk(sI, "Button", {
        Title = "Reset UI settings", Desc = "Scale, size, theme, transparency and keys back to default",
        Callback = function()
            for k, v in pairs(defaults) do cfg[k] = v end
            applyAll()
            pcall(function() ui.scale:Set(100) end)
            pcall(function() ui.width:Set(defaults.width) end)
            pcall(function() ui.height:Set(defaults.height) end)
            pcall(function() ui.transparent:Set(false) end)
            pcall(function() ui.transparency:Set(20) end)
            pcall(function() ui.theme:Select(defaults.theme) end)
            pcall(function() ui.key:Set(defaults.toggleKey) end)
            pcall(function() ui.openBtn:Set(true) end)
            pcall(function() ui.openDrag:Set(true) end)
            pcall(function() ui.notif:Set(false) end)
            saveUI()
            notify("UI settings reset", "", "rotate-ccw", 2)
        end,
    })

    ---------------- System ----------------
    local sS = mk(st, "Section", {Title = "System", Opened = true}) or st
    local fpsOptions = {"Don't change", "30", "60", "75", "90", "120", "144", "165", "240", "Unlimited"}
    local function fpsLabel(n)
        if n < 0 then return "Don't change" end
        if n == 0 then return "Unlimited" end
        return tostring(n)
    end
    mk(sS, "Dropdown", {
        Title = "FPS cap", Desc = "Needs an executor with setfpscap",
        Values = fpsOptions, Value = fpsLabel(cfg.fpscap),
        Multi = false, AllowNone = false,
        Callback = function(v)
            if type(v) == "table" then v = v[1] end
            if v == "Don't change" then cfg.fpscap = -1
            elseif v == "Unlimited" then cfg.fpscap = 0
            else cfg.fpscap = tonumber(v) or -1 end
            applyFps(); touch()
        end,
    })
    mk(sS, "Toggle", {
        Title = "Anti-AFK", Desc = "Stops Roblox from kicking you for being idle",
        Value = cfg.antiafk,
        Callback = function(v) cfg.antiafk = v; applyAFK(); touch() end,
    })
    mk(sS, "Button", {
        Title = "Rejoin this server",
        Callback = function()
            notify("Rejoining...", "", "refresh-cw", 2)
            pcall(function()
                if #Players:GetPlayers() <= 1 then
                    TeleportService:Teleport(game.PlaceId, LP)
                else
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP)
                end
            end)
        end,
    })
    mk(sS, "Button", {Title = "Copy Place ID", Callback = function() copy(game.PlaceId) end})
    mk(sS, "Button", {Title = "Copy Job ID", Callback = function() copy(game.JobId) end})
    mk(sS, "Button", {Title = "Copy my User ID", Callback = function() copy(LP.UserId) end})
    mk(sS, "Button", {
        Title = "Test notification",
        Callback = function() notify("Spectre", "Notifications are working", "bell", 3) end,
    })

    ---------------- Danger zone ----------------
    local sD = mk(st, "Section", {Title = "Danger zone", Opened = false}) or st
    mk(sD, "Button", {
        Title = "Save everything now", Desc = "Feature config + UI settings",
        Callback = function()
            pcall(func22, false); saveUI()
            notify("Saved", "Config and UI settings saved", "save", 2)
        end,
    })
    mk(sD, "Button", {
        Title = "Destroy UI", Desc = "Closes and unloads Spectre",
        Callback = function()
            alive = false
            pcall(func22, false); saveUI()
            pcall(function() if afkConn then afkConn:Disconnect() end end)
            pcall(function() Window:Destroy() end)
        end,
    })

    -- apply the saved UI settings once the window is ready
    task.delay(0.6, applyAll)
end, function(e) warn("[Spectre UI] " .. tostring(e)) end)

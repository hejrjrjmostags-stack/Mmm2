local function makeElement(tab, method, config)
    -- Add controls to the currently active WindUI section so each Reach group
    -- keeps its complete original set of controls together.
    local target = (tab and tab._activeSection) or (tab and tab._windTab)
    local callback = target and target[method]
    assert(type(callback) == "function", "WindUI does not support control: " .. tostring(method))
    return callback(target, config)
end

-- A hidden legacy tab can still have setup code that stores element handles
-- and calls :Set() later. Return harmless dummy handles instead of nil so
-- skipped tabs cannot abort script initialization before Sky Changer is built.
local function makeDummy()
    local dummy = {}
    return setmetatable(dummy, {
        __index = function(self, key)
            if key == "Get" then return function() return nil end end
            return function() return self end
        end,
        __newindex = function(self, key, value) rawset(self, key, value) end,
    })
end
local function makeHiddenTab()
    local dummyTab = {}
    return setmetatable(dummyTab, {
        __index = function()
            return function() return makeDummy() end
        end,
    })
end
function v2:CreateTab(config)
    config = config or {}
    local tabName = tostring(config.Name or "Tab")
    local displayName = tabName == "Head Reach & Moss" and "Head Reach" or tabName == "Config Save" and "Settings" or tabName
    local keepTabs = {
        ["Home"] = true,
        ["Reach"] = true,
        ["Xeno & Solara Reach"] = true,
        ["Head Reach"] = true,
        ["Xeno Moss"] = true,
        ["React"] = true,
        ["Sky Changer"] = true,
        ["Helpers"] = true,
        ["Settings"] = true,
    }
    -- Suppress every non-requested tab and all of its controls/callbacks.
    if not keepTabs[displayName] then
        return makeHiddenTab()
    end
    local windTab = prebuiltTabs[displayName] or Window:Tab({
        Title = displayName,
        Icon = config.Icon or "layout-dashboard",
    })
    local tab = {_windTab = windTab, _activeSection = nil}
    function tab:CreateSection(title)
        self._activeSection = self._windTab:Section({Title = tostring(title or "Section"), Opened = true})
        return self._activeSection
    end
    function tab:CreateParagraph(data)
        data = data or {}
        return makeElement(self, "Paragraph", {
            Title = tostring(data.Title or ""),
            Desc = tostring(data.Content or data.Desc or ""),
        })
    end
    function tab:CreateLabel(data)
        data = data or {}
        local title = tostring(data.Text or "")
        local card = makeElement(self, "Paragraph", {Title = title, Desc = ""})
        if type(data.Update) == "function" then
            task.spawn(function()
                while card do
                    local ok, result = pcall(data.Update)
                    if ok and result ~= nil then
                        pcall(function() card:SetTitle(tostring(result)) end)
                    end
                    task.wait(math.clamp(tonumber(data.UpdateRate) or 1, 0.2, 10))
                end
            end)
        end
        return card
    end
    function tab:CreateButton(data)
        data = data or {}
        return makeElement(self, "Button", {
            Title = tostring(data.Name or data.Title or "Button"),
            Desc = data.Description or data.Desc,
            Callback = data.Callback or function() end,
        })
    end
    function tab:CreateToggle(data)
        data = data or {}
        return makeElement(self, "Toggle", {
            Title = tostring(data.Name or data.Title or "Toggle"),
            Desc = data.Description or data.Desc,
            Value = data.CurrentValue == true,
            Callback = data.Callback or function() end,
        })
    end
    function tab:CreateSlider(data)
        data = data or {}
        local range = data.Range or {0, 100}
        return makeElement(self, "Slider", {
            Title = tostring(data.Name or data.Title or "Slider"),
            Desc = data.Description or data.Desc,
            Value = {Min = tonumber(range[1]) or 0, Max = tonumber(range[2]) or 100, Default = tonumber(data.CurrentValue) or tonumber(range[1]) or 0},
            Step = tonumber(data.Increment) or 1,
            IsTooltip = true,
            IsTextbox = true,
            Callback = data.Callback or function() end,
        })
    end
    function tab:CreateDropdown(data)
        data = data or {}
        local values = data.Options or data.Values or {}
        local initial = data.CurrentOption
        local dropdown = makeElement(self, "Dropdown", {
            Title = tostring(data.Name or data.Title or "Dropdown"),
            Values = values,
            Value = initial,
            Multi = false,
            AllowNone = false,
            SearchBarEnabled = true,
            Callback = data.Callback or function() end,
        })
        -- Spectre uses :Set(value); WindUI dropdowns use :Select({value}).
        pcall(function()
            dropdown.Set = function(element, value)
                element:Select({value})
            end
        end)
        return dropdown
    end
    function tab:CreateInput(data)
        data = data or {}
        return makeElement(self, "Input", {
            Title = tostring(data.Name or data.Title or "Input"),
            Desc = data.Description or data.Desc,
            Placeholder = data.PlaceholderText or data.Placeholder or "",
            Value = tostring(data.CurrentValue or ""),
            Type = "Input",
            Callback = data.Callback or function() end,
        })
    end
    return tab
end

local function clearPred()
	for i=1,predCount do if predParts[i] then predParts[i].Parent=nil end end
	predCount=0
end

RunService.Heartbeat:Connect(function()
	if not predFlag then clearPred(); return end
	local Game=workspace:FindFirstChild("Game"); local eng=Game and Game:FindFirstChild("Engine")
	if not eng then clearPred(); return end
	local ball; local huge=math.huge
	local ch=LocalPlayer.Character; local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
	for _,child in ipairs(eng:GetChildren()) do
		if child:IsA("BasePart") and child.Name=="Ball" then
			local d=hrp and (hrp.Position-child.Position).Magnitude or 0
			if d<huge then huge=d; ball=child end
		end
	end
	if not ball or ball.AssemblyLinearVelocity.Magnitude<0.2 then clearPred(); return end
	local pts={}; pts[1]=ball.Position
	local vel=ball.AssemblyLinearVelocity; local pos=ball.Position
	local grav=Vector3.new(0,-196.2,0)*0.03
	for i=2,predSteps+1 do
		vel=vel+grav; local npos=pos+vel*0.03
		pts[i]=npos; pos=npos
	end
	for i=1,predSteps do
		local a,b2=pts[i],pts[i+1]
		if a and b2 then
			local mag=(b2-a).Magnitude

				currentKeybindName = keyName
				if v2 and v2.SetToggleKey then v2:SetToggleKey(currentKeybindName) end
				if keybindDropdown and keybindDropdown.Set then keybindDropdown:Set(currentKeybindName) end
				v1:Notify({Title="Keybind Set",Content="GUI toggle key is now "..currentKeybindName,Type="Success",Duration=2})
			else
				v1:Notify({Title="Invalid KeyCode",Content="'"..keyName.."' is not a valid Roblox KeyCode",Type="Warning",Duration=2})
			end
		end
	end,
})


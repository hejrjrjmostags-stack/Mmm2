-- helper: build tab wrapper for fut-style AddToggle/AddSlider etc.
local futTabWrapNum = 0
local function futWrap(tabObj, tabKey)
	local num = 0
	local tbl = {}

	tbl.AddSeperator = function(_, arg2) tabObj:CreateSection(tostring(arg2 or "Section")) end
	tbl.AddSeparator = tbl.AddSeperator

	function tbl:AddButton(arg2, arg3)
		if type(arg2) == "table" then
			return tabObj:CreateButton({Name=arg2.title or arg2.Name or "Button", Desc=arg2.desc or arg2.Desc or "", Callback=arg2.callback or arg2.Callback})
		end
		return tabObj:CreateButton({Name=tostring(arg2 or "Button"), Callback=arg3})
	end

	function tbl:AddToggle(arg21)
		local v1 = arg21 or {}
		num = num + 1
		return tabObj:CreateToggle({
			Name = v1.title or v1.Name or "Toggle",
			Desc = v1.desc or v1.Desc or "",
			CurrentValue = v1.checked == true or v1.CurrentValue == true,
			Callback = v1.callback or v1.Callback,
		})
	end

	function tbl:AddSlider(arg21)
		local v1 = arg21 or {}
		local v2 = v1.values or {}
		local default = v2.default
		if default == nil then default = v2.min or 0 end
		local increment = v2.round and (v2.round >= 1 and 1 or 10^(-v2.round)) or 1
		num = num + 1
		return tabObj:CreateSlider({
			Name = v1.title or v1.Name or "Slider",
			Desc = v1.desc or v1.Desc or "",
			Range = {v2.min or 0, v2.max or 100},
			CurrentValue = default,
			Callback = v1.callback or v1.Callback,
		})
	end

	function tbl:AddDropdown(arg21)
		local v1 = arg21 or {}
		local v2 = v1.options or v1.Options or {}
		local default = v1.default
		if type(default) == "number" then default = v2[default] end
		if default == nil then default = v2[1] end
		num = num + 1
		return tabObj:CreateDropdown({
			Name = v1.title or v1.Name or "Dropdown",
			Desc = v1.desc or v1.Desc or "",
			Options = v2,
			CurrentOption = default,
			Callback = function(selected)
				local sel = type(selected) == "table" and selected[1] or selected
				local idx
				for i, opt in ipairs(v2) do if opt == sel then idx = i; break end end
				if v1.callback then v1.callback(idx, sel)
				elseif v1.Callback then v1.Callback(sel) end
			end,
		})
	end

	function tbl:AddLabel(_, arg2) return tabObj:CreateLabel(tostring(arg2 or "")) end
	function tbl:AddDivider(_) end

	function tbl:AddInput(_, arg21)
		local v1 = arg21 or {}
		num = num + 1
		return tabObj:CreateInput({

-- (Full AutoGK logic from fut script inserted here)
local gkCfg = {
	AutoDive=true, AutoJump=true, DiveEarlier=0.35, DiveCommitRadius=24,
	SlowSpeed=1, MinSpeed=1, MaxDist=600, IncomingMaxT=8, ShotMaxT=8,
	DiveForce=25, DiveTween=0.2, ArmReach=2.5, StandReach=3.2, JumpGain=4.9,
	CeilSlack=0.6, LowRel=0.2, HighRel=1.335, LowHardBand=0.5,
	LowDiveRadius=4.5, HighDiveRadius=4, HistoryWindow=0.3, MinSamples=5,
	SampleInterval=0.00833, MaxCurveAccel=600, CurveDecayTau=1.5,
	UseAngularVel=true, AngularToAccel=0.55, RequireGoal=false,
	HeldProximityDist=4, HeldMaxSpeed=12,
}
local gkState={DiveUntil=0,JumpUntil=0,LockBall=nil,LastDive=nil,LastFireName=nil,RetryCount=0,Stats={Dives=0,Jumps=0,Low=0,High=0,Mid=0}}
local gkBalls={}; local gkGoals={}; local gkHistory={}; local gkLastSample={}; local gkDiveModules={}

local function gkGetBalls()
	local t={}; for k in pairs(gkBalls) do if k.Parent then table.insert(t,k) end end; return t
end
local function gkGetGoals()
	local t={}; for k in pairs(gkGoals) do if k.Parent then table.insert(t,k) end end; return t
end
local function gkFindGK()
	local ch=LocalPlayer.Character
	if not ch then return nil end
	return ch:FindFirstChild("GK") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("GK"))
end

for _,d in ipairs(Workspace:GetDescendants()) do
	if d:IsA("BasePart") then
		local n=d.Name:lower()
		if n:find("ball") then gkBalls[d]=true end
		if n:find("goal") or n:find("net") then gkGoals[d]=true end
	end
end
Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("BasePart") then
		local n=d.Name:lower()
		if n:find("ball") then gkBalls[d]=true end
		if n:find("goal") or n:find("net") then gkGoals[d]=true end
	end
end)
Workspace.DescendantRemoving:Connect(function(d)
	gkBalls[d]=nil; gkGoals[d]=nil; gkHistory[d]=nil; gkLastSample[d]=nil
	if gkState.LockBall==d then gkState.LockBall=nil end
end)

local function gkIsHeld(ball)
	if not (ball and ball.Parent) then return false end
	local v=ball.AssemblyLinearVelocity
	if math.sqrt(v.X*v.X+v.Y*v.Y+v.Z*v.Z)<=gkCfg.HeldMaxSpeed then
		for _,p in ipairs(Players:GetPlayers()) do
			local ch=p.Character; local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
			if hrp and (ball.Position-hrp.Position).Magnitude<=gkCfg.HeldProximityDist then return true end
		end
	end
	return false
end

local function gkSample(ball)
	local t=os.clock()
	if t-(gkLastSample[ball] or 0)<gkCfg.SampleInterval then return end
	gkLastSample[ball]=t
	gkHistory[ball]=gkHistory[ball] or {}
	table.insert(gkHistory[ball],{t=t,p=ball.Position,v=ball.AssemblyLinearVelocity})
	while #gkHistory[ball]>0 and t-gkHistory[ball][1].t>gkCfg.HistoryWindow do
		table.remove(gkHistory[ball],1)
	end
end

local function gkFitBall(ball)
	local h=gkHistory[ball]
	if not h or #h<gkCfg.MinSamples then
		if not h or #h==0 then return nil end
		local last=h[#h]; return last.p,last.v,Vector3.zero
	end
	local last=h[#h]
	return last.p,last.v,Vector3.zero
end

local function gkFireDive(name)
	if gkDiveModules[name] then
		pcall(gkDiveModules[name].new)
		return true
	end
	local gk=gkFindGK(); if not gk then return false end
	local mod=(gk:FindFirstChild("Client") or gk:FindFirstChild("Dives") or gk):FindFirstChild(name)
	if not mod then return false end
	local ok,res=pcall(require,mod)
	if ok and type(res)=="table" and res.new then
		gkDiveModules[name]=res
		pcall(res.new)
		gkState.LastFireName=name
		return true
	end
	return false
end

local function gkStep()
	local ch=LocalPlayer.Character
	local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp or not gkFindGK() then return end
	for _,ball in ipairs(gkGetBalls()) do gkSample(ball) end
	local best,bestT=nil,math.huge
	for _,ball in ipairs(gkGetBalls()) do
		if not gkIsHeld(ball) then
			local p,v,_=gkFitBall(ball)
			if p then
				local relX=(hrp.CFrame:PointToObjectSpace(p)).X
				local t0=(ball.Position-hrp.Position).Magnitude/math.max(ball.AssemblyLinearVelocity.Magnitude,1)
				if t0<bestT and t0<gkCfg.IncomingMaxT then bestT=t0; best=ball end
			end
		end
	end
	if not best then gkState.LockBall=nil; return end
	gkState.LockBall=best
	local p,velVec,_=gkFitBall(best)
	if not p then return end
	local relX=(hrp.CFrame:PointToObjectSpace(p)).X
	local relY=p.Y-hrp.Position.Y
	local t=bestT
	local now=os.clock()
	local hum=ch and ch:FindFirstChildOfClass("Humanoid")
	if gkCfg.AutoJump and hum and t<gkState.JumpUntil+0.5 then
		if relY>gkCfg.StandReach+0.3 and relY<2 and hum.FloorMaterial~=Enum.Material.Air then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,true)
				hum.Jump=true
			end)
			gkState.JumpUntil=now+0.35
			gkState.Stats.Jumps=gkState.Stats.Jumps+1
		end
	end
	if not gkCfg.AutoDive then return end
	if now<gkState.DiveUntil then return end
	if math.abs(relX)<=gkCfg.ArmReach and relY<=gkCfg.StandReach and relY>=gkCfg.LowRel then return end
	local maxLat=gkCfg.DiveCommitRadius*1.6
	if math.abs(relX)>maxLat then return end
	local diveName
	if relY<=gkCfg.LowRel+gkCfg.LowHardBand then
		diveName = relX<-gkCfg.LowDiveRadius and "lowdiveL" or relX>gkCfg.LowDiveRadius and "lowdiveR" or "highdive"
	else
		diveName = relX<-gkCfg.HighDiveRadius and "highdiveL" or relX>gkCfg.HighDiveRadius and "highdiveR" or "highdive"
	end
	gkState.DiveUntil=now+0.2
	gkState.Stats.Dives=gkState.Stats.Dives+1
	gkFireDive(diveName)
end

RunService.Heartbeat:Connect(function() pcall(gkStep) end)


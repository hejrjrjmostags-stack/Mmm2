-- ============================================================
-- SPECTRE FLOATING TOGGLE (separate ScreenGui; controls the real Spectre GUI)
-- ============================================================
task.spawn(function()
    local UIS = game:GetService("UserInputService")
    local Tween = game:GetService("TweenService")
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer

    local parent
    local ok = pcall(function()
        if gethui then parent = gethui() end
    end)
    if not parent then
        parent = game:GetService("CoreGui")
    end

    local old = parent:FindFirstChild("Spectre_FloatingToggle")
    if old then old:Destroy() end

    local toggleGui = Instance.new("ScreenGui")
    toggleGui.Name = "Spectre_FloatingToggle"
    toggleGui.ResetOnSpawn = false
    toggleGui.IgnoreGuiInset = true
    toggleGui.DisplayOrder = 100000
    toggleGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    toggleGui.Parent = parent

    local button = Instance.new("TextButton")
    button.Name = "SpectreToggle"
    button.AnchorPoint = Vector2.new(0, 0.5)
    button.Size = UDim2.fromOffset(48, 48)
    button.Position = UDim2.new(0, 16, 0.5, 0)
    button.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    button.BorderSizePixel = 0
    button.Text = "S"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 21
    button.Font = Enum.Font.GothamBold
    button.AutoButtonColor = false
    button.Active = true
    button.ZIndex = 10
    button.Parent = toggleGui

    local round = Instance.new("UICorner")
    round.CornerRadius = UDim.new(1, 0)
    round.Parent = button

    local outline = Instance.new("UIStroke")
    outline.Color = Color3.fromRGB(235, 235, 235)
    outline.Thickness = 1.4
    outline.Transparency = 0.12
    outline.Parent = button

    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = button

    local dragging = false
    local moved = false
    local pressPosition
    local startPosition
    local activeInput

    local function clampPosition(x, y)
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
        local maxX = math.max(0, viewport.X - button.AbsoluteSize.X)
        local maxY = math.max(0, viewport.Y - button.AbsoluteSize.Y)
        return UDim2.fromOffset(
            math.clamp(x, 0, maxX),
            math.clamp(y, 0, maxY)
        )
    end

    local function setMainVisible(visible)
        -- v4 is the ScreenGui created by this Spectre script.
        if v4 and v4.Parent then
            v4.Enabled = visible
        end
        Tween:Create(button, TweenInfo.new(0.14), {
            TextColor3 = visible and Color3.fromRGB(255, 255, 255)
                or Color3.fromRGB(145, 145, 145)
        }):Play()
    end

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            activeInput = input
            pressPosition = input.Position
            startPosition = button.AbsolutePosition
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - pressPosition
            if delta.Magnitude > 7 then moved = true end
            if moved then
                button.Position = clampPosition(
                    startPosition.X + delta.X,
                    startPosition.Y + delta.Y
                )
            end
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            local wasClick = not moved
            dragging = false
            activeInput = nil
            if wasClick then
                local currentlyVisible = v4 and v4.Parent and v4.Enabled
                setMainVisible(not currentlyVisible)
                Tween:Create(scale, TweenInfo.new(0.09), {Scale = 0.86}):Play()
                task.delay(0.09, function()
                    if scale.Parent then
                        Tween:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back), {Scale = 1}):Play()
                    end
                end)
            end
        end
    end)

    -- Keep the button inside the visible screen after rotation/resizing.
    local camera = workspace.CurrentCamera
    if camera then
        camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            local pos = button.AbsolutePosition
            button.Position = clampPosition(pos.X, pos.Y)
        end)
    end
end)

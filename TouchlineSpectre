local cachedMainGui = nil
local function findPunishGui()
    if cachedMainGui and cachedMainGui.Parent then
        return cachedMainGui
    end
    local roots = {}
    pcall(function()
        if gethui then
            local h = gethui()
            if h then table.insert(roots, h) end
        end
    end)
    pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then table.insert(roots, playerGui) end
    -- 1) exact name
    for _, root in ipairs(roots) do
        local gui = root:FindFirstChild("punishgoatUI")
        if gui and gui:IsA("ScreenGui") then
            cachedMainGui = gui
            return gui
        end
    end
    -- 2) any punish UI fallback
    for _, root in ipairs(roots) do
        for _, child in ipairs(root:GetChildren()) do
            if child:IsA("ScreenGui") and child.Name:lower():find("punish") then
                cachedMainGui = child
                return child
            end
        end
    end
    return nil
end


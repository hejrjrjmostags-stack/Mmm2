-- SETTINGS TAB - CONFIG SYSTEM + 20 THEMES ONLY
-- ============================================================
do
    local HttpService2 = game:GetService("HttpService")
    local settingsTab = Window:CreateTab("Settings")

    local function notify(title, message)
        func5(title, message, 3)
    end

    local hasFS = type(writefile) == "function"
        and type(readfile) == "function"
        and type(isfile) == "function"
        and type(isfolder) == "function"
        and type(makefolder) == "function"
        and type(listfiles) == "function"
        and type(delfile) == "function"

    local memConfigs, autoLoadName = {}, nil
    local folder = "SpectreTouchline"
    local configFolder = folder .. "/configs"

    local function sanitize(name)
        return tostring(name or "")
            :gsub("[^%w%-_ ]", "")
            :gsub("^%s+", "")
            :gsub("%s+$", "")
            :sub(1, 32)
    end

    if hasFS then
        pcall(function()
            if not isfolder(folder) then makefolder(folder) end
            if not isfolder(configFolder) then makefolder(configFolder) end
        end)
    end

    local function configPath(name)
        return configFolder .. "/" .. sanitize(name) .. ".json"
    end

    local function collectValues()
        local values = {}
        for key, element in pairs(tbl24.Elements or {}) do
            if element and type(element.get) == "function" then
                local ok, value = pcall(element.get)
                if ok then values[key] = value end
            end
        end
        return {
            version = 4,
            theme = Library.CurrentTheme or "Spectre",
            values = values
        }
    end

    local function listConfigs()
        local names = {}
        if hasFS then
            local ok, files = pcall(listfiles, configFolder)
            if ok and type(files) == "table" then
                for _, file in ipairs(files) do
                    local name = tostring(file):match("([^/\\]+)%.json$")
                    if name then names[#names + 1] = name end
                end
            end
        else
            for name in pairs(memConfigs) do
                names[#names + 1] = name
            end
        end
        table.sort(names, function(a, b)
            return a:lower() < b:lower()
        end)
        return names
    end

    local function saveConfig(name)
        name = sanitize(name)
        if name == "" then
            return false, "Type a config name first"
        end

        local ok, json = pcall(function()
            return HttpService2:JSONEncode(collectValues())
        end)
        if not ok then
            return false, "Could not encode config values"
        end

        if hasFS then
            local saved, err = pcall(writefile, configPath(name), json)
            if not saved then return false, tostring(err) end
        else
            memConfigs[name] = json
        end
        return true, name
    end

    local function loadConfig(name)
        name = sanitize(name)
        if name == "" then
            return false, "Select or enter a config name"
        end

        local raw
        if hasFS then
            local existsOk, exists = pcall(isfile, configPath(name))
            if not (existsOk and exists) then
                return false, "Config not found"
            end
            local readOk, data = pcall(readfile, configPath(name))
            if not readOk then
                return false, "Could not read config file"
            end
            raw = data
        else
            raw = memConfigs[name]
        end

        if type(raw) ~= "string" then
            return false, "Config not found"
        end

        local decodedOk, decoded = pcall(function()
            return HttpService2:JSONDecode(raw)
        end)
        if not decodedOk or type(decoded) ~= "table" then
            return false, "Config is corrupted"
        end

        if decoded.theme and Library.Themes and Library.Themes[decoded.theme] then
            pcall(function()
                Library:ChangeTheme(decoded.theme)
            end)
        end

        local count = 0
        for key, value in pairs(decoded.values or {}) do
            local element = tbl24.Elements and tbl24.Elements[key]
            if element and type(element.set) == "function" then
                if pcall(element.set, value) then
                    count = count + 1
                end
            end
        end
        return true, count
    end

    local function deleteConfig(name)
        name = sanitize(name)
        if name == "" then
            return false, "Enter a config name"
        end

        if hasFS then
            local existsOk, exists = pcall(isfile, configPath(name))
            if not (existsOk and exists) then
                return false, "Config not found"
            end
            local ok, err = pcall(delfile, configPath(name))
            if not ok then return false, tostring(err) end
        else
            if not memConfigs[name] then
                return false, "Config not found"
            end
            memConfigs[name] = nil
        end
        return true
    end

    local function getAutoLoad()
        if hasFS then
            local ok, exists = pcall(isfile, folder .. "/autoload.txt")
            if ok and exists then
                local readOk, value = pcall(readfile, folder .. "/autoload.txt")
                if readOk then return sanitize(value) end
            end
            return nil
        end
        return autoLoadName
    end

    local function setAutoLoad(name)
        if hasFS then
            if name then
                local ok, err = pcall(writefile, folder .. "/autoload.txt", sanitize(name))
                if not ok then return false, tostring(err) end
            else
                pcall(function()
                    local path = folder .. "/autoload.txt"
                    if isfile(path) then delfile(path) end
                end)
            end
        else
            autoLoadName = name and sanitize(name) or nil
        end
        return true
    end

    -- CONFIG SYSTEM
    settingsTab:CreateSection("Config System")
    if not hasFS then
        settingsTab:CreateLabel("File APIs unavailable: configs are session-only.")
    end

    local configName, selectedConfig = "", ""
    local configList

    settingsTab:CreateInput(
        "Config Name",
        "Enter a name before saving.",
        "MyConfig",
        nil,

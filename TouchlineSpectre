-- Track feature controls so named configs can save and restore feature state.
tbl24.Elements = tbl24.Elements or {}
local function registerSpectreControl(tabName, controlName, initialValue, setter)
    local key = tostring(tabName or "Features") .. "/" .. tostring(controlName or "Control")
    local safeKey, suffix = key, 2
    while tbl24.Elements[safeKey] do
        safeKey = key .. " #" .. suffix
        suffix = suffix + 1
    end
    local value = initialValue
    tbl24.Elements[safeKey] = {
        get = function() return value end,
        set = function(newValue)
            value = newValue
            if setter then setter(newValue) end
        end
    }
    return function(newValue)
        value = newValue
        if setter then setter(newValue) end
    end
end

tbl24.MakeTab = function(_, tabName, iconName, order)
    local tabLabel = tostring(tabName or "Features")
    local baseTab = Window:CreateTab(tabLabel)
    local adapter = {}

    function adapter:AddSection(name, first)
        return baseTab:CreateSection(tostring(name or ""))
    end
    function adapter:AddParagraph(title, body)
        return baseTab:CreateParagraph(tostring(title or ""), tostring(body or ""))
    end
    function adapter:AddNote(note)
        return baseTab:CreateLabel(tostring(note or ""))
    end
    function adapter:AddButton(name, callback, description)
        return baseTab:CreateButton(tostring(name or "Button"), tostring(description or ""), nil, callback)
    end
    function adapter:AddToggle(config)
        config = config or {}
        local current, callback = config.Default == true, config.Callback
        local setValue = registerSpectreControl(tabLabel, config.Name, current, function(value)
            if callback then callback(value == true) end
        end)
        baseTab:CreateToggle(tostring(config.Name or "Toggle"), tostring(config.Description or config.Desc or ""),
            current, function(value) setValue(value == true) end)
        return {Get = function() return current end, Set = setValue}
    end
    function adapter:AddSlider(config)
        config = config or {}
        local minimum, maximum = tonumber(config.Min) or 0, tonumber(config.Max) or 100
        if maximum <= minimum then maximum = minimum + 1 end
        local current = math.clamp(tonumber(config.Default) or minimum, minimum, maximum)
        local callback = config.Callback
        local setValue = registerSpectreControl(tabLabel, config.Name, current, function(value)
            current = math.clamp(tonumber(value) or minimum, minimum, maximum)
            if callback then callback(current) end
        end)
        baseTab:CreateSlider(tostring(config.Name or "Slider"), minimum, maximum, current,
            function(value) setValue(value) end)
        return {Get = function() return current end, Set = setValue}
    end
    function adapter:AddTextBox(config)
        config = config or {}
        local current, callback = "", config.Callback
        local setValue = registerSpectreControl(tabLabel, config.Name, current, function(value)
            current = tostring(value or "")
            if callback then callback(current) end
        end)
        baseTab:CreateInput(tostring(config.Name or "Input"),
            tostring(config.Description or config.Desc or ""),
            tostring(config.PlaceholderText or config.Placeholder or ""), nil, nil,
            function(value) setValue(value) end)
        return {Get = function() return current end, Set = setValue}
    end
    function adapter:AddKeybind(config)
        config = config or {}
        local current = config.Default or Enum.KeyCode.Unknown
        local callback = config.ChangedCallback or config.Callback
        local function toKey(value)
            if typeof(value) == "EnumItem" then return value end
            if type(value) == "string" then return Enum.KeyCode[value] or Enum.KeyCode.Unknown end
            return Enum.KeyCode.Unknown
        end
        local control
        local setValue = registerSpectreControl(tabLabel, config.Name, current.Name, function(value)
            current = toKey(value)
            if control and control.Set then pcall(control.Set, control, current) end
            if callback then callback(current) end
        end)
        control = baseTab:CreateKeybind(tostring(config.Name or "Keybind"),
            tostring(config.Description or config.Desc or ""), current, function(value)
                setValue(value.Name)
            end)
        return {Get = function() return current.Name end, Set = setValue}
    end
    function adapter:AddList(config)
        config = config or {}
        local current = config.Default
        local callback = config.OnSelect or config.Callback
        local setValue = registerSpectreControl(tabLabel, config.Name, current, function(value)
            current = value
            if callback then callback(value) end
        end)
        local control = baseTab:CreateSelect(tostring(config.Name or "List"),
            tostring(config.Description or config.Desc or ""),
            config.Items or config.Options or {}, current,
            function(selected)
                local value = type(selected) == "table" and selected[1] or selected
                setValue(value)
            end)
        return {
            SetItems = function(_, items)
                if control and control.Refresh then pcall(control.Refresh, control, items or {}, true) end
            end,
            Select = function(_, value)
                if control and control.Set then pcall(control.Set, control, value)
                else setValue(value) end
            end,
            Get = function() return current end
        }
    end
    function adapter:AddColorpicker(config)
        config = config or {}
        local current, callback = config.Default, config.Callback
        local function toHex(color)
            if typeof(color) ~= "Color3" then return tostring(color or "FFFFFF") end
            return string.format("%02X%02X%02X", math.floor(color.R*255+0.5),
                math.floor(color.G*255+0.5), math.floor(color.B*255+0.5))
        end
        local setValue = registerSpectreControl(tabLabel, config.Name, toHex(current), function(value)
            local hex = tostring(value or ""):gsub("#", "")
            if #hex == 6 and hex:match("^[%x]+$") then
                current = Color3.fromRGB(tonumber(hex:sub(1,2),16), tonumber(hex:sub(3,4),16), tonumber(hex:sub(5,6),16))
                if callback then callback(current) end
            end
        end)
        baseTab:CreateInput(tostring(config.Name or "Color"), "Color input (hex RGB)",
            "Enter hex color, e.g. FFFFFF", nil, nil, function(value) setValue(value) end)
        return {Get = function() return toHex(current) end, Set = setValue}
    end
    function adapter:AddStepper(config)
        config = config or {}
        local minimum, maximum = tonumber(config.Min) or 0, tonumber(config.Max) or 100
        if maximum <= minimum then maximum = minimum + 1 end
        local current, callback = tonumber(config.Default) or minimum, config.Callback
        local setValue = registerSpectreControl(tabLabel, config.Name, current, function(value)
            current = math.clamp(tonumber(value) or minimum, minimum, maximum)
            if callback then callback(current) end
        end)
        baseTab:CreateSlider(tostring(config.Name or "Value"), minimum, maximum, current,
            function(value) setValue(value) end)
        return {Get = function() return current end, Set = setValue}
    end
    return adapter
end


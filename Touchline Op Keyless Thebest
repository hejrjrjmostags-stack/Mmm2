local function registerControl(tabLabel, name, getter, setter)
	local key = tostring(tabLabel) .. "/" .. tostring(name or "Control")
	local base, n = key, 2
	while SpectreCfg.controls[key] do key = base .. " #" .. n n = n + 1 end
	local okd, dv = pcall(getter)
	SpectreCfg.controls[key] = {get = getter, set = setter, default = okd and dv or nil}
	table.insert(SpectreCfg.order, key)
end


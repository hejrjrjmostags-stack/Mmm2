tbl24.MakeTab = function(_, tabName, iconName)
	local label = TAB_RENAME[tabName] or tostring(tabName or "Features")
	local tab = Window:CreateTab({Name = label, Desc = "Touchline", Icon = TAB_ICONS[tabName] or iconName or "layers"})
	local adapter = {}
	local function reg(name, obj) registerControl(label, name, obj.Get, obj.Set) return obj end

	function adapter:AddSection(name) return tab:CreateSection(tostring(name or "")) end
	function adapter:AddParagraph(title, body)
		return tab:CreateParagraph({Title = tostring(title or ""), Content = tostring(body or "")})
	end
	function adapter:AddNote(text) return tab:CreateLabel({Text = tostring(text or "")}) end
	function adapter:AddButton(name, callback, description)
		return tab:CreateButton({Name = tostring(name or "Button"), Desc = tostring(description or ""), Callback = function()
			if callback then callback() end
		end})
	end

	-- shared helper: one callback per change, whether set by the user or by code
	local function bind(initial, onChange)
		local state = {current = initial, silent = false, ctrl = nil}
		function state.fire(v) state.current = v if onChange then onChange(v) end end
		function state.userChanged(v) if not state.silent then state.fire(v) end end
		function state.set(v)
			state.silent = true
			if state.ctrl and state.ctrl.Set then pcall(state.ctrl.Set, state.ctrl, v) end
			state.silent = false
			state.fire(v)
		end
		return state
	end

	function adapter:AddToggle(config)
		config = config or {}
		local st = bind(config.Default == true, function(v) if config.Callback then config.Callback(v == true) end end)
		st.ctrl = tab:CreateToggle({Name = tostring(config.Name or "Toggle"), Desc = tostring(config.Description or config.Desc or ""),
			CurrentValue = st.current, Callback = function(v) st.userChanged(v == true) end})
		return reg(config.Name, {Get = function() return st.current end, Set = function(v) st.set(v == true) end})
	end
	function adapter:AddSlider(config)
		config = config or {}
		local minimum, maximum = tonumber(config.Min) or 0, tonumber(config.Max) or 100
		if maximum <= minimum then maximum = minimum + 1 end
		local start = math.clamp(tonumber(config.Default) or minimum, minimum, maximum)
		local st = bind(start, function(v) if config.Callback then config.Callback(v) end end)
		st.ctrl = tab:CreateSlider({Name = tostring(config.Name or "Slider"), Range = {minimum, maximum},
			Increment = stepFor(minimum, maximum), CurrentValue = start, Callback = function(v) st.userChanged(tonumber(v) or start) end})
		return reg(config.Name, {Get = function() return st.current end, Set = function(v) st.set(math.clamp(tonumber(v) or minimum, minimum, maximum)) end})
	end
	adapter.AddStepper = adapter.AddSlider
	function adapter:AddTextBox(config)
		config = config or {}
		local st = bind("", function(v) if config.Callback then config.Callback(v) end end)
		st.ctrl = tab:CreateInput({Name = tostring(config.Name or "Input"),
			PlaceholderText = tostring(config.PlaceholderText or config.Placeholder or ""), Default = "",
			Callback = function(v) st.userChanged(tostring(v or "")) end})
		return reg(config.Name, {Get = function() return st.current end, Set = function(v) st.set(tostring(v or "")) end})
	end
	function adapter:AddKeybind(config)
		config = config or {}
		local function toKey(v)
			if typeof(v) == "EnumItem" then return v end
			return Enum.KeyCode[tostring(v)] or Enum.KeyCode.Unknown
		end
		local current = toKey(config.Default)
		local cb = config.ChangedCallback or config.Callback
		local options = {}
		for _, n in ipairs(KEY_NAMES) do table.insert(options, n) end
		if not table.find(options, current.Name) then table.insert(options, 1, current.Name) end
		local st = bind(current.Name, function(v) current = toKey(v) if cb then cb(current) end end)
		st.ctrl = tab:CreateDropdown({Name = tostring(config.Name or "Keybind"), Options = options,
			CurrentOption = current.Name, Callback = function(v)
				st.userChanged(type(v) == "table" and v[1] or v)
			end})
		return reg(config.Name, {Get = function() return current.Name end, Set = function(v) st.set(toKey(v).Name) end})
	end
	function adapter:AddList(config)
		config = config or {}
		local callback = config.OnSelect or config.Callback
		local st = bind(config.Default, function(v) if callback then callback(v) end end)
		st.ctrl = tab:CreateDropdown({Name = tostring(config.Name or "List"), Options = config.Items or config.Options or {},
			CurrentOption = config.Default, Callback = function(v) st.userChanged(type(v) == "table" and v[1] or v) end})
		return reg(config.Name, {
			Set = function(v) st.set(v) end,
			SetItems = function(_, items) if st.ctrl and st.ctrl.Refresh then pcall(st.ctrl.Refresh, st.ctrl, items or {}) end end,
			Select = function(_, v) st.set(v) end,
			Get = function() return st.current end,
		})
	end
	function adapter:AddColorpicker(config)
		config = config or {}
		local function toHex(c)
			if typeof(c) ~= "Color3" then return "FFFFFF" end
			return string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
		end
		local current = config.Default
		local st = bind(toHex(current), function(v)
			local hex = tostring(v or ""):gsub("#", "")
			if #hex == 6 and hex:match("^%x+$") then
				current = Color3.fromRGB(tonumber(hex:sub(1,2),16), tonumber(hex:sub(3,4),16), tonumber(hex:sub(5,6),16))
				if config.Callback then config.Callback(current) end
			end
		end)
		st.ctrl = tab:CreateInput({Name = tostring(config.Name or "Color") .. " (hex)", PlaceholderText = "FFFFFF", Default = toHex(current),
			Callback = function(v) st.userChanged(v) end})
		return reg(config.Name, {Get = function() return toHex(current) end, Set = function(v) st.set(v) end})
	end
	return adapter
end


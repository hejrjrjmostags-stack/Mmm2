v32:CreateButton({Name = "Copy Config to Clipboard", Callback = function()
	local okEnc, enc = pcall(function()
		return HttpService:JSONEncode({version = 1, name = currentConfigName, game = "Touchline", values = collectValues()})
	end)
	if okEnc and type(setclipboard) == "function" and pcall(setclipboard, enc) then
		notify("Copied", "Current settings copied as JSON")
	else
		notify("Copy Failed", "Clipboard not available", "Error")
	end
end})
v32:CreateInput({
	Name = "Import Config (paste JSON)",
	PlaceholderText = "Paste copied JSON, then press Enter...",
	Default = "",
	Callback = function(val)
		if not val or val == "" then return end
		local ok, data = pcall(function() return HttpService:JSONDecode(val) end)
		if ok and type(data) == "table" and type(data.values) == "table" then
			local n = applyValues(data.values)
			notify("Imported", n .. " controls applied. Press Save Config to keep them.")
		else
			notify("Import Failed", "Invalid config JSON", "Error")
		end
	end,
})
v32:CreateButton({Name = "Reset All Features to Default", Callback = function()
	local n = 0
	for _, key in ipairs(SpectreCfg.order) do
		local c = SpectreCfg.controls[key]
		if c and c.default ~= nil and pcall(c.set, c.default) then n = n + 1 end
	end
	notify("Reset", n .. " controls restored to defaults", "Info")
end})

-- ---- UI toggle keybind ----
v32:CreateSection("UI Toggle Keybind")
v32:CreateParagraph({Title = "Default key", Content = "RightShift shows/hides the menu. You can change it below."})
local currentKeybindName = "RightShift"
local keybindDropdown
local uiKeyCode = Enum.KeyCode.RightShift
local libCanRebind = Window ~= nil and type(Window.SetKeybind) == "function"

local function applyUiKey(name, showNotify)
	local code = Enum.KeyCode[tostring(name)]
	if not code then
		if showNotify then notify("Invalid KeyCode", "'" .. tostring(name) .. "' is not a valid KeyCode", "Warning") end
		return false
	end
	currentKeybindName = code.Name
	uiKeyCode = code
	if libCanRebind then pcall(function() Window:SetKeybind(code) end) end
	if keybindDropdown and keybindDropdown.Set then pcall(keybindDropdown.Set, keybindDropdown, currentKeybindName) end
	if showNotify then notify("Keybind Updated", "Menu toggle is now " .. currentKeybindName) end
	return true
end

-- fallback: if the library cannot rebind, a second listener toggles the menu on the new key
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or libCanRebind then return end
	if uiKeyCode ~= Enum.KeyCode.RightShift and input.KeyCode == uiKeyCode then
		pcall(function() if Window.Toggle then Window:Toggle() end end)
	end
end)

keybindDropdown = v32:CreateDropdown({
	Name = "UI Toggle Keybind",
	Options = {"RightShift", "RightControl", "LeftControl", "Insert", "Delete", "F4", "F8", "Backquote"},
	CurrentOption = "RightShift",
	Callback = function(selected)
		local opt = type(selected) == "table" and selected[1] or selected
		if opt and opt ~= "" and opt ~= currentKeybindName then applyUiKey(opt, true) end
	end,
})
v32:CreateInput({
	Name = "Custom Keybind",
	PlaceholderText = "Type any KeyCode (e.g. RightShift, P, E)...",
	Default = "RightShift",
	Callback = function(val)
		if val and val ~= "" then applyUiKey((tostring(val):gsub("%s+", "")), true) end
	end,
})

-- keybind is saved with the config too
SpectreCfg.controls["Settings/UI Toggle Keybind"] = {
	get = function() return currentKeybindName end,
	set = function(v) applyUiKey(v, false) end,
	default = "RightShift",
}
table.insert(SpectreCfg.order, "Settings/UI Toggle Keybind")

v32:CreateSection("Interface")
v32:CreateButton({Name = "Destroy UI", Callback = function() pcall(function() Window:Destroy() end) end})

getgenv()._SpectreTouchline_Cleanup = function() pcall(function() Window:Destroy() end) end

-- auto-load the chosen config on startup
task.spawn(function()
	task.wait(2)
	local name = readAutoload()
	if name and loadConfig(name, false) then
		currentConfigName = name
		if configNameBox and configNameBox.Set then pcall(configNameBox.Set, configNameBox, name) end
		notify("Auto Loaded", "Applied config: " .. name)
	end
end)

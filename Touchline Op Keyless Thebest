local v32 = Window:CreateTab({Name = "Settings", Desc = "Configs & UI", Icon = "settings"})

local CFG_DIR = "SpectreTouchline_Configs"
local AUTOLOAD_FILE = CFG_DIR .. "/_autoload.txt"
local currentConfigName = "default"
local newConfigName = ""
local savedConfigsDropdown, configNameBox, autoLoadToggle

local function hasFS() return type(writefile) == "function" and type(readfile) == "function" end
local function cleanName(n)
	local s = tostring(n or "")
	s = s:gsub("[^%w_%- ]", "")
	s = s:gsub("^%s+", "")
	s = s:gsub("%s+$", "")
	return s
end
local function cfgPath(name) return CFG_DIR .. "/" .. name .. ".json" end
local function ensureDir()
	pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
	end)
end
local function notify(title, content, kind)
	v1:Notify({Title = title, Content = content, Type = kind or "Success", Duration = 2.5})
end
local function listConfigs()
	local list = {}
	pcall(function()
		if type(listfiles) == "function" and type(isfolder) == "function" and isfolder(CFG_DIR) then
			for _, f in ipairs(listfiles(CFG_DIR)) do
				local n = tostring(f):match("([^\\/]+)%.json$")
				if n and n:sub(1, 1) ~= "_" and not table.find(list, n) then table.insert(list, n) end
			end
		end
	end)
	table.sort(list, function(a, b) return a:lower() < b:lower() end)
	if #list == 0 then list = {"default"} end
	return list
end
local function readAutoload()
	local name
	pcall(function()
		if type(isfile) == "function" and isfile(AUTOLOAD_FILE) then name = cleanName(readfile(AUTOLOAD_FILE)) end
	end)
	if name == "" then name = nil end
	return name
end
local function collectValues()
	local values = {}
	for _, key in ipairs(SpectreCfg.order) do
		local c = SpectreCfg.controls[key]
		local ok, v = pcall(c.get)
		local tv = type(v)
		if ok and (tv == "boolean" or tv == "number" or tv == "string") then values[key] = v end
	end
	return values
end
local function applyValues(values)
	local n = 0
	for _, key in ipairs(SpectreCfg.order) do
		local c = SpectreCfg.controls[key]
		local v = values[key]
		if c and v ~= nil and pcall(c.set, v) then n = n + 1 end
	end
	return n
end
local function refreshConfigList(selectName)
	local list = listConfigs()
	if savedConfigsDropdown and savedConfigsDropdown.Refresh then
		local pick = selectName
		if not pick or not table.find(list, pick) then pick = list[1] end
		pcall(function() savedConfigsDropdown:Refresh(list, pick) end)
	end
end
local function saveConfig(name, showNotify)
	name = cleanName(name)
	if name == "" then name = "default" end
	if not hasFS() then if showNotify then notify("Save Failed", "Your executor has no file access", "Error") end return false end
	ensureDir()
	local payload = {version = 1, name = name, game = "Touchline", saved = os.time(), values = collectValues()}
	local okEnc, enc = pcall(function() return HttpService:JSONEncode(payload) end)
	if not okEnc then if showNotify then notify("Save Failed", tostring(enc), "Error") end return false end
	local okW = pcall(writefile, cfgPath(name), enc)
	if showNotify then
		if okW then notify("Config Saved", name .. " (" .. #SpectreCfg.order .. " controls)") else notify("Save Failed", "Could not write " .. name .. ".json", "Error") end
	end
	return okW
end
local function readConfig(name)
	name = cleanName(name)
	if name == "" then return nil, "empty name" end
	local content
	pcall(function() if type(isfile) == "function" and isfile(cfgPath(name)) then content = readfile(cfgPath(name)) end end)
	if not content or content == "" then return nil, "not found" end
	local ok, data = pcall(function() return HttpService:JSONDecode(content) end)
	if not ok or type(data) ~= "table" then return nil, "corrupted" end
	return data
end
local function loadConfig(name, showNotify)
	name = cleanName(name)
	local data, err = readConfig(name)
	if not data then
		if showNotify then notify(err == "corrupted" and "Corrupted Config" or "Not Found", name .. ".json: " .. tostring(err), "Warning") end
		return false
	end
	local n = applyValues(type(data.values) == "table" and data.values or {})
	if showNotify then notify("Config Loaded", name .. " (" .. n .. " controls applied)") end
	return true
end
local function deleteConfig(name)
	name = cleanName(name)
	if type(delfile) ~= "function" then notify("Delete Failed", "Your executor has no delfile", "Error") return false end
	local ok = false
	pcall(function() if isfile(cfgPath(name)) then delfile(cfgPath(name)) ok = true end end)
	if ok then
		if readAutoload() == name then pcall(delfile, AUTOLOAD_FILE) if autoLoadToggle and autoLoadToggle.Set then pcall(autoLoadToggle.Set, autoLoadToggle, false) end end
		notify("Config Deleted", name .. ".json removed")
	else
		notify("Not Found", name .. ".json does not exist", "Warning")
	end
	return ok
end


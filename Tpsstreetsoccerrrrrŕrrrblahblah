local function func24(cfgName, showNotify)
	cfgName = tostring(cfgName or "default"):gsub("[^%w_%-]", "")
	if cfgName == "" then cfgName = "default" end
	local filePath = "TPS_Configs/" .. cfgName .. ".json"
	local content = nil
	local readOk = pcall(function()
		if type(isfile) == "function" and isfile(filePath) then
			content = readfile(filePath)
		elseif type(readfile) == "function" then
			content = readfile(filePath)
		end
	end)
	if not readOk or not content or content == "" then
		if cfgName == "default" then
			pcall(function()
				if type(isfile) == "function" and isfile("TPS_Configs/Config.json") then
					content = readfile("TPS_Configs/Config.json")
				end
			end)
		end
	end
	if not content or content == "" then
		if showNotify then v1:Notify({Title = "Not Found", Content = cfgName .. ".json does not exist", Type = "Warning", Duration = 2}) end
		return false
	end
	local ok_dec, decoded = pcall(function() return tbl8.decode(content) end)
	if not ok_dec or type(decoded) ~= "table" then
		if showNotify then v1:Notify({Title = "Corrupted", Content = "Invalid JSON structure", Type = "Error", Duration = 2}) end
		return false
	end
	func23(decoded)
	if showNotify then v1:Notify({Title = "Config Loaded", Content = "Successfully loaded " .. cfgName, Type = "Success", Duration = 2}) end
	return true
end


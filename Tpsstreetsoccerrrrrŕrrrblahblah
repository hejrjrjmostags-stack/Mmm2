-- Helper for exact string replacement
local function replaceExact(source, target, replacement)
	local p1, p2 = source:find(target, 1, true)
	if p1 then
		return source:sub(1, p1 - 1) .. replacement .. source:sub(p2 + 1)
	end
	return source
end


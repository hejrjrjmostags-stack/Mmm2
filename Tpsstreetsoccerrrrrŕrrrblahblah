	local ch = LocalPlayer.Character; if not ch then return end
	local hum = ch:FindFirstChildOfClass("Humanoid"); if not hum then return end
	if not avSaved2 then avSave2() end
	local a, c = avApplyId2(uid, ch, hum)
	avLastId2 = uid
	v1:Notify({Title="Avatar", Content="✓ "..a.." accs, "..c.." clothes", Duration=3})
end

